  m_Script: {fileID: 11500000, guid: 7c77329f92c75c14ab29a55227b2de44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryManager
  diaryPanel: {fileID: 225783790}
  diaryText: {fileID: 2083184590}
  gameManager: {fileID: 1631473855}
  noAnomalyTexts:
  - "\u9589\u9928\u5F8C\u3001\u6307\u793A\u3069\u304A\u308A\u5C55\u793A\u5BA4\u3092\u4E00\u5468\u3057\u305F\u3002\r\n\u7167\u660E\u306F\u843D\u3061\u3001\u7D75\u3060\u3051\u304C\u308F\u305A\u304B\u306B\u898B\u3048\u308B\u3002\r\n\u672C\u65E5\u3001\u8A18\u9332\u3059\u3079\u304D\u5DEE\u7570\u306F\u8A8D\u3081\u3089\u308C\u306A\u304B\u3063\u305F\u3002"
  - "\u6628\u65E5\u3068\u540C\u3058\u9806\u8DEF\u3002\u5E8A\u306E\u97FF\u304D\u4EE5\u5916\u306B\u52D5\u304F\u3082\u306E\u306F\u306A\u3044\u3002\r\n\u5C55\u793A\u306B\u7570\u5E38\u306F\u898B\u5F53\u305F\u3089\u306A\u3044\u3002\u4EE5\u4E0A\u3002"
  - "\u5DE6\u53F3\u5BA4\u307E\u3067\u542B\u3081\u3066\u78BA\u8A8D\u3057\u305F\u3002\r\n\u4F4D\u7F6E\u3001\u5927\u304D\u3055\u3001\u5411\u304D\u3001\u3044\u305A\u308C\u3082\u6628\u65E5\u3068\u5DEE\u306F\u306A\u3044\u3002\r\n\u7570\u5E38\u306A\u3057\u3002"
  - "\u30E9\u30A4\u30C8\u3092\u843D\u3068\u3057\u3066\u3082\u3001\u58C1\u3068\u5E8A\u306E\u5370\u8C61\u306F\u6628\u65E5\u3069\u304A\u308A\u3002\r\n\u64AE\u5F71\u306E\u5FC5\u8981\u306F\u306A\u304B\u3063\u305F\u3002"
  - "\u76EE\u3092\u96E2\u3057\u305F\u3042\u3068\u3001\u3082\u3046\u4E00\u5EA6\u540C\u3058\u7D75\u3092\u898B\u305F\u3002\r\n\u5909\u5316\u306F\u78BA\u8A8D\u3067\u304D\u305A\u3002\u8AA4\u8A8D\u3060\u3063\u305F\u53EF\u80FD\u6027\u304C\u9AD8\u3044\u3002"
  - "\u5DE1\u56DE\u7D4C\u8DEF\u3001\u6249\u3001\u30D9\u30F3\u30C1\u306B\u554F\u984C\u306A\u3057\u3002\r\n\u7D75\u753B\u306B\u3082\u524D\u65E5\u3068\u306E\u5DEE\u3092\u8A8D\u3081\u306A\u3044\u3002"
  - "\u540C\u3058\u70B9\u3092\u4E8C\u5EA6\u78BA\u8A8D\u3057\u305F\u3002\u3044\u305A\u308C\u3082\u6628\u65E5\u3068\u540C\u3058\u3002\r\n\u672C\u65E5\u306E\u8A18\u9332\u4E8B\u9805\u306F\u306A\u3057\u3002"
  - "\u6697\u3044\u5C55\u793A\u5BA4\u3092\u898F\u5B9A\u3069\u304A\u308A\u4E00\u5468\u3002\r\n\u7570\u5909\u306E\u5831\u544A\u306B\u306F\u81F3\u3089\u306A\u3044\u3002"
  - "\u6700\u7D42\u65E5\u524D\u65E5\u3002\u5C55\u793A\u306F\u9759\u304B\u306A\u307E\u307E\u3002\r\n\u5DEE\u7570\u306A\u3057\u3002"
  - "\u6700\u7D42\u65E5\u300210\u65E5\u9593\u306E\u5DE1\u56DE\u3092\u6E80\u4E86\u3057\u305F\u3002\r\n\u672C\u65E5\u3001\u8A18\u9332\u3059\u3079\u304D\u5909\u5316\u306F\u306A\u304B\u3063\u305F\u3002\r\n\u4EE5\u964D\u306F\u4E0A\u306E\u5224\u65AD\u306B\u59D4\u306D\u308B\u3002"
  anomalyTexts:
  - "\u521D\u65E5\u3060\u304C\u3001\u65E2\u306B\u6C17\u306B\u306A\u308B\u70B9\u304C\u3042\u3063\u305F\u3002\r\n\u898F\u5B9A\u3069\u304A\u308A\u64AE\u5F71\u3057\u3001\u5165\u53E3\u306B\u3066\u5831\u544A\u3059\u308B\u3002"
  - "\u6628\u65E5\u3068\u540C\u3058\u306F\u305A\u306E\u7D75\u304C\u3001\u540C\u3058\u306B\u898B\u3048\u306A\u3044\u3002\r\n\u8A3C\u62E0\u3092\u6B8B\u3057\u305F\u3002"
  - "\u5965\u306E\u58C1\u306E\u524D\u3067\u9577\u304F\u7ACB\u3061\u6B62\u307E\u3063\u305F\u3002\r\n\u69CB\u56F3\u306E\u5370\u8C61\u304C\u6628\u65E5\u3068\u305A\u308C\u3066\u3044\u308B\u3002\u5199\u771F\u3092\u6DFB\u4ED8\u3059\u308B\u3002"
  - "\u8FD1\u3065\u304F\u307E\u3067\u5206\u304B\u3089\u306A\u3044\u5909\u5316\u304C\u3042\u3063\u305F\u3002\r\n\u96E2\u308C\u3066\u898B\u308B\u3068\u666E\u901A\u306B\u623B\u308B\u6C17\u304C\u3059\u308B\u3002\u64AE\u308C\u305F\u3082\u306E\u3060\u3051\u8A18\u9332\u3059\u308B\u3002"
  - "\u76EE\u3092\u5916\u3057\u305F\u9699\u306B\u3001\u5C55\u793A\u304C\u9055\u3063\u3066\u898B\u3048\u305F\u3002\r\n\u898B\u7D9A\u3051\u3066\u3044\u308B\u3042\u3044\u3060\u306F\u5909\u308F\u3089\u306A\u3044\u3002\u8A18\u9332\u3092\u6B8B\u3059\u3002"
  - "\u4F4D\u7F6E\u304B\u5927\u304D\u3055\u3060\u3051\u304C\u6C17\u306B\u306A\u308B\u3002\r\n\u8AA4\u5831\u3092\u907F\u3051\u308B\u305F\u3081\u3001\u64AE\u5F71\u3067\u304D\u305F\u3082\u306E\u4EE5\u5916\u306F\u66F8\u304B\u306A\u3044\u3002"
  - "\u4E00\u5EA6\u76EE\u3068\u4E8C\u5EA6\u76EE\u3067\u5370\u8C61\u304C\u9055\u3046\u3002\r\n\u75B2\u308C\u304B\u3082\u3057\u308C\u306A\u3044\u304C\u3001\u898F\u5B9A\u3069\u304A\u308A\u5199\u771F\u3092\u6B8B\u3057\u305F\u3002"
  - "\u30E9\u30A4\u30C8\u3092\u843D\u3068\u3059\u3068\u58C1\u306E\u8D64\u3060\u3051\u304C\u6B8B\u308B\u3002\r\n\u305D\u306E\u4E2D\u3067\u3001\u6628\u65E5\u3068\u540C\u3058\u306F\u305A\u306E\u4E00\u70B9\u304C\u540C\u3058\u306B\u898B\u3048\u306A\u3044\u3002"
  - "\u7D4C\u8DEF\u3082\u5BB6\u5177\u3082\u6628\u65E5\u3069\u304A\u308A\u3002\r\n\u5909\u308F\u3063\u3066\u3044\u308B\u306E\u306F\u7D75\u306E\u5074\u3060\u3051\u306B\u898B\u3048\u308B\u3002\u5199\u771F\u3092\u6DFB\u3048\u308B\u3002"
  - "\u6700\u7D42\u65E5\u3002\u521D\u65E5\u306B\u306F\u306A\u304B\u3063\u305F\u9055\u548C\u611F\u304C\u6B8B\u3063\u3066\u3044\u308B\u3002\r\n\u8A18\u9332\u306F\u4EE5\u4E0A\u3002\u4EE5\u964D\u306E\u5224\u65AD\u306F\u4E0A\u306B\u59D4\u306D\u308B\u3002"
